# ============================================================
# InternVision Portal — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# ── API ──────────────────────────────────────────────────────
# URL of the Spring Boot backend
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Production (replace with your Render URL):
# NEXT_PUBLIC_API_BASE_URL=https://your-app-name.onrender.com

# ── Razorpay ─────────────────────────────────────────────────
# PUBLIC key only — never put the secret here.
# Obtain from: https://dashboard.razorpay.com > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
