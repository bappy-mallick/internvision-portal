# ============================================================
# InternVision Portal — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# ── API ──────────────────────────────────────────────────────
# URL of the Spring Boot backend (includes /api/v1 prefix)
NEXT_PUBLIC_API_URL=https://internvision-portal.onrender.com/api/v1

# ── Razorpay ─────────────────────────────────────────────────
# PUBLIC key only — never put the secret here.
# Obtain from: https://dashboard.razorpay.com > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
