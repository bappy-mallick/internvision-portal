# ============================================================
# InternVision Portal — Root .gitignore
# ============================================================

# ──────────────── Secrets & Environment ────────────────
.env
.env.local
.env.*.local
.env.production
.env.development

# Firebase service account (NEVER commit this)
firebase-service-account.json

# ──────────────── Backend (Maven / Spring Boot) ────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/!**/src/main/**/target/
backend/!**/src/test/**/target/

# ──────────────── Frontend (Node / Next.js) ────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/

# ──────────────── IDE ────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# ──────────────── OS ────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ──────────────── Logs ────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────── Build outputs ────────────────
*.class
*.jar
!**/src/main/**/build/
!**/src/test/**/build/
dist/
build/
