# ============================================================
# InternVision Portal — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ──────────────── Server ────────────────
PORT=8080

# ──────────────── JWT ────────────────
# Minimum 256-bit (32-character) random string.
# Generate one at: https://generate.plus/en/base64
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_256_BIT_SECRET_KEY_HERE
JWT_EXPIRATION=86400000

# ──────────────── Razorpay ────────────────
# Obtain from: https://dashboard.razorpay.com > Settings > API Keys
# Use TEST mode keys only.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET

# ──────────────── Firebase ────────────────
# Obtain from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID

# Option A — File path to the service account JSON (local development):
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# Option B — For Render/cloud deployment, paste the full JSON as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ──────────────── CORS ────────────────
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
